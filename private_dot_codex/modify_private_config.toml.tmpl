#!/bin/sh
# Only manage the home-assistant MCP server and the [tui] table.
# Codex owns the rest of this file, for example the model settings.
# TOML has no tool like jq that keeps the formatting, so awk changes only these lines.
HA_URL={{ .homeAssistantMcpUrl | squote }} \
WANT_HA={{ if .isWorkMachine }}0{{ else }}1{{ end }} \
exec awk '
BEGIN { url = ENVIRON["HA_URL"]; want = ENVIRON["WANT_HA"] == 1 }
/^[ \t]*\[/ {
  name = $0
  sub(/^[ \t]*\[+[ \t]*/, "", name); sub(/[ \t]*\].*$/, "", name); gsub(/"/, "", name)
  table = (name == "mcp_servers.home-assistant")
  subtable = (index(name, "mcp_servers.home-assistant.") == 1)
  if (name == "tui") tui = 1
  if (table) {
    seen = 1
    if (want) { print; print "url = \"" url "\"" }
    next
  }
}
(table || subtable) && !want { next }
table && /^[ \t]*url[ \t]*=/ { next }
{ print }
END {
  sep = NR ? "\n" : ""
  if (want && !seen) { printf "%s[mcp_servers.home-assistant]\nurl = \"%s\"\n", sep, url; sep = "\n" }
  if (!tui) printf "%s[tui]\nscreen_reader_detection_done = true\n", sep
}'
